# Your test secret key from the KetaPay dashboard (Developers → API keys). Never commit the real one.
KETAPAY_SECRET_KEY=sk_test_...

# The signing secret of the webhook endpoint you add for this example (shown once when you add it)
KETAPAY_WEBHOOK_SECRET=whsec_...

# Where this example runs: KetaPay sends the buyer back here after paying
BASE_URL=http://localhost:4242

# Your commission in basis points (250 = 2.5%), capped below. Must be within your KetaPay agreement.
COMMISSION_BPS=250

# The most your commission can be on one sale, in kobo (50000000 = ₦500,000)
COMMISSION_MAX=50000000

# Leave unset to use the KetaPay API. Only set it if KetaPay gave you another address to test against.
# KETAPAY_BASE_URL=
